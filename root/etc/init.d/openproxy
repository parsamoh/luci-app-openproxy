#!/bin/sh /etc/rc.common
START=95
STOP=10

USE_PROCD=1
PROC_BIN=$(uci -q get openproxy.config.core)

LANIP=$(uci -q get network.lan.ipaddr)
WORK_PATH=/etc/openproxy
DNS_PORT=1053
REDIR_PORT=3333
TPROXY_PORT=3330
YACD_PORT=9090
YACD_UI="$WORK_PATH/ui"
YACD_SECRET="router"

TPROXY_MARK=0xff  # Mark for data flowing through clash (different from nftable mark, preventing duplicate processing)
ROUTER_MARK=0x01  # Routing mark
CONFIG_FILE=$WORK_PATH/config.yaml  # Effective startup configuration file path (regenerated every restart)

RUNLOG_FILE=/tmp/openproxy.log

LOGGER() {
    line_count=$(cat $RUNLOG_FILE | wc -l)
    if [ "$line_count" -gt "1000" ] ; then
        rm $RUNLOG_FILE
    fi
    echo -e "$(date +'%Y/%m/%d %H:%M:%S'): $@" | tee -a $RUNLOG_FILE
}

# Configure nftables rules: config file method
configure_nftables() {

    LOGGER "Add IPv4 routing rules"
    # IPv4
    ip rule add fwmark ${ROUTER_MARK} lookup 100
    ip route add local default dev lo table 100 2>/dev/null

    enable_ipv6=$(uci -q get openproxy.config.ipv6)
    if [ "$enable_ipv6" == "1" ] ; then
        LOGGER "Add IPv6 routing rules"
        # IPv6
        ip -6 rule add fwmark ${ROUTER_MARK} lookup 100
        ip -6 route add local default dev lo table 100 2>/dev/null
    fi
    enable_custom_dns=$(uci -q get openproxy.config.enable_custom_dns)
    if [ "$enable_custom_dns" == "1" ] ; then
        dns_port=$(uci -q get openproxy.config.dns_port)
        [[ -z "$dns_port" ]] && dns_port="53" #Default external third-party DNS port is 53
    else
        dns_port="$DNS_PORT"
    fi
    if [ "$dns_port" != "53" ] ; then
        # Configure DNS forwarding#
        if [ -z "$(nft list chain inet fw4 dstnat |grep 'OpenProxy DNS Hijack')" ]; then
            nft insert rule inet fw4 dstnat position 0 iifname != "wt0" iifname != "netbird0" udp dport 53 redirect to "$dns_port" comment \"OpenProxy DNS Hijack\"
        fi
    fi

    # Load region-specific IP sets based on user selection
    region=$(uci -q get openproxy.config.region)
    [[ -z "$region" ]] && region="china" # Default to china if not set
    
    LOGGER "Selected region for IP filtering: $region"
    
    # Load appropriate IP set file
    case "$region" in
        china)
            LOGGER "Loading Chinese IP sets"
            nft -f ${WORK_PATH}/rules_nft/nftset_all_cn_ips.nft
            REGION_IPV4_SET="cnipv4"
            REGION_IPV6_SET="cnipv6"
            ;;
        iran)
            LOGGER "Loading Iranian IP sets"
            nft -f ${WORK_PATH}/rules_nft/nftset_iran_ips.nft
            REGION_IPV4_SET="iranipv4"
            REGION_IPV6_SET="iranipv6"
            ;;
        russia)
            LOGGER "Loading Russian IP sets"
            nft -f ${WORK_PATH}/rules_nft/nftset_russia_ips.nft
            REGION_IPV4_SET="ruipv4"
            REGION_IPV6_SET="ruipv6"
            ;;
        none)
            LOGGER "No region-specific IP filtering (all traffic will be proxied except local)"
            # Create minimal IP sets with only local IPs
            cat > /tmp/nftset_none.nft <<EOF
#!/usr/sbin/nft -f
table inet oproxy_tproxy {
    set local_ipv4 {
        type ipv4_addr ;
        flags interval ;
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0-255.255.255.255 }
    }
    set local_ipv6 {
        type ipv6_addr ;
        flags interval ;
        elements = { ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8, ::ffff:0:0/96, ::ffff:0:0:0/96, 64:ff9b::/96, 100::/64, 2001::/32, 2001:20::/28, 2001:db8::/32, 2002::/16 }
    }
    set all_ipv6 {
        type ipv6_addr ;
        flags interval ;
        elements = { ::/0 }
    }
}
EOF
            nft -f /tmp/nftset_none.nft
            REGION_IPV4_SET=""
            REGION_IPV6_SET=""
            ;;
        *)
            LOGGER "Unknown region: $region, defaulting to china"
            nft -f ${WORK_PATH}/rules_nft/nftset_all_cn_ips.nft
            REGION_IPV4_SET="cnipv4"
            REGION_IPV6_SET="cnipv6"
            ;;
    esac
    
    LOGGER "Add nftable TPROXY rules"
    enable_trans_ipv6=$(uci -q get openproxy.config.trans_ipv6)
    if [ "$enable_trans_ipv6" == "1" ] ; then
        nft -f ${WORK_PATH}/rules_nft/openproxy_tproxy_trans_ipv6.nft
    else
        nft -f ${WORK_PATH}/rules_nft/openproxy_tproxy.nft
    fi
    
    # Inject region-specific bypass rules if a region is selected
    if [ -n "$REGION_IPV4_SET" ]; then
        LOGGER "Injecting region-specific IP bypass rules for $region"
        # Insert rules after local IP checks (position 4 for prerouting, similar for output)
        nft insert rule inet oproxy_tproxy prerouting position 4 ip daddr @${REGION_IPV4_SET} return
        nft insert rule inet oproxy_tproxy prerouting position 5 ip6 daddr @${REGION_IPV6_SET} return
        nft insert rule inet oproxy_tproxy output position 4 ip daddr @${REGION_IPV4_SET} return
        nft insert rule inet oproxy_tproxy output position 5 ip6 daddr @${REGION_IPV6_SET} return
    fi
}

# Clean up nftables rules
cleanup_nftables() {
    # Clean up rules
    LOGGER "2.Clean up nftable TPROXY rules"
    nft delete table inet oproxy_tproxy >/dev/null 2>&1
    dns_port=$(uci -q get openproxy.config.dns_port)
    [[ -z "$dns_port" ]] && dns_port="$DNS_PORT"
    if [ "$dns_port" != "53" ] ; then
        # Configure DNS forwarding#
        if [ ! -z "$(nft list chain inet fw4 dstnat |grep 'OpenProxy DNS Hijack')" ]; then
            handle=$(nft -a list chain inet fw4 dstnat | grep 'OpenProxy DNS Hijack' | awk '{print $NF}')
            if [ ! -z "$handle" ]; then
                nft delete rule inet fw4 dstnat handle $handle >/dev/null 2>&1
            fi
        fi
    fi
    LOGGER "3.Clean up routing rules"
    ip rule delete fwmark ${ROUTER_MARK} lookup 100 >/dev/null 2>&1
    ip -6 rule delete fwmark ${ROUTER_MARK} lookup 100 >/dev/null 2>&1
    LOGGER "4.Reload firewall rules"
    # /etc/init.d/firewall reload 2>/dev/null
}

# Surgically reload only the region IP sets in nftables without touching chains/rules.
# Call this after the nftset_*.nft file has been updated on disk.
reload_nftables_sets() {
    region=$(uci -q get openproxy.config.region)
    [[ -z "$region" ]] && region="china"

    LOGGER "Surgical nft set reload for region: $region"

    case "$region" in
        china)
            SET4="cnipv4" ; SET6="cnipv6"
            NFT_FILE="${WORK_PATH}/rules_nft/nftset_all_cn_ips.nft"
            ;;
        iran)
            SET4="iranipv4" ; SET6="iranipv6"
            NFT_FILE="${WORK_PATH}/rules_nft/nftset_iran_ips.nft"
            ;;
        russia)
            SET4="ruipv4" ; SET6="ruipv6"
            NFT_FILE="${WORK_PATH}/rules_nft/nftset_russia_ips.nft"
            ;;
        *)
            LOGGER "reload_nftables_sets: unknown region '$region', skipping"
            return 0
            ;;
    esac

    # Check the table exists (service may be stopped)
    if ! nft list table inet oproxy_tproxy >/dev/null 2>&1 ; then
        LOGGER "reload_nftables_sets: oproxy_tproxy table not loaded, skipping live reload"
        return 0
    fi

    # Atomically flush existing set elements, then load the new file
    nft flush set inet oproxy_tproxy "${SET4}" 2>/dev/null
    nft flush set inet oproxy_tproxy "${SET6}" 2>/dev/null
    nft -f "${NFT_FILE}"

    LOGGER "Surgical nft set reload complete (${SET4}, ${SET6})"
}

# Reload Mihomo config + optionally refresh nft IP sets.
# Does NOT touch nftables chains/rules — no network disruption.
reload_service() {
    LOGGER "Reloading openproxy (SIGHUP Mihomo + config regeneration)"

    # Regenerate the effective config file from template
    check_config_file || {
        LOGGER "Config check failed during reload — aborting reload"
        return 1
    }

    # Send SIGHUP so Mihomo picks up the new config without restarting
    local mihomo_pid
    mihomo_pid=$(pidof clash mihomo 2>/dev/null | awk '{print $1}')
    if [ -n "$mihomo_pid" ]; then
        kill -HUP "$mihomo_pid"
        LOGGER "Sent SIGHUP to Mihomo (PID $mihomo_pid)"
    else
        LOGGER "Mihomo not running — nothing to reload"
    fi
}


# Check Yaml format startup configuration file: parameter modification, formatting, etc.
check_config_file() {
    # Check support mode
    LOGGER "Start verifying Yaml startup configuration file"
    if which lsmod >/dev/null 2>&1 ; then
        lsmod |grep -i ^nft_tproxy >/dev/null 2>&1
    fi
    if [ "$?" != "0" ] ; then
        LOGGER "Verification of startup conditions failed: TPROXY module missing, please install kmod-nft-tproxy and try again."
        return 1
    fi
    port_expr=".redir-port=${REDIR_PORT}|.allow-lan=true|.mode=\"rule\"|"

    enable_ipv6=$(uci -q get openproxy.config.ipv6)
    ipv6_status="false" # IPv6 support disabled by default
    if [ "$enable_ipv6" == "1" ] ; then
        ipv6_status="true"
    fi
    dns_enable="true"
    enable_custom_dns=$(uci -q get openproxy.config.enable_custom_dns)
    dns_port=$(uci -q get openproxy.config.dns_port)
    if [ "$enable_custom_dns" == "1" ] ; then
        # Use third-party DNS service, disable Clash internal DNS service at this time
        dns_enable="false"
        dns_port=$(uci -q get openproxy.config.dns_port)
        [[ -z "$dns_port" ]] && dns_port="53" # Default external third-party DNS is port 53
    else
        dns_port="$DNS_PORT"
    fi
    ipv6_expr=".ipv6=${ipv6_status}|.dns.enable=${dns_enable}|.dns.listen=strenv(dns_listen)|.dns.ipv6=${ipv6_status}|.dns.enhanced-mode=strenv(enmode)|"
    tmode_expr=""
    mode=$(uci -q get openproxy.config.mode)
    [[ "$mode" =~ "TPROXY" ]] && tmode_expr=".routing-mark=${TPROXY_MARK}|.tproxy-port=${TPROXY_PORT}|"

    # Get selected dashboard type
    dashboard_type=$(uci -q get openproxy.config.dashboard_type)
    [[ -z "$dashboard_type" ]] && dashboard_type="yacd" # Default use yacd
    DASHBOARD_UI="$WORK_PATH/ui/$dashboard_type"
    
    dashboard_url="http://${LANIP}:${YACD_PORT}/ui/?hostname=${LANIP}&port=${YACD_PORT}&secret=${YACD_SECRET}"
    uci set openproxy.config.yacd_url=${dashboard_url}
    uci commit openproxy

    # Modify proxy-providers and rule-providers directories
    proxy_expr='.["proxy-providers"] |= with_entries(select(.value.type == "http") | .value.path |= sub("^.*/", "./providers_proxy/"),select(.value.type == "file") | .value.path |= sub("^.*/", "./custom_proxy/"))|'
    rule_expr='.["rule-providers"] |= with_entries(select(.value.type == "http") | .value.path |= sub("^.*/", "./providers_rule/"),select(.value.type == "file") | .value.path |= sub("^.*/", "./custom_rule/"))|'
    
    # Inject Client Proxy Groups and Rules
    CLIENT_EXPR=""
    CLIENT_RULES_LINES=""
    # Function to handle each client section
    handle_client_conf() {
        local config=$1
        local enable name ip
        config_get_bool enable "$config" enable 1
        config_get name "$config" name
        config_get ip "$config" ip_addr
        
        # Build proxies list
        local proxies_json=""
        append_proxy() {
             # Handle space-separated values if stored as string, or single items
             for p in $1; do
                 if [ -z "$proxies_json" ]; then
                     proxies_json="\"$p\""
                 else
                     proxies_json="$proxies_json, \"$p\""
                 fi
             done
        }
        # Try as list
        config_list_foreach "$config" proxies append_proxy
        # Try as option (space separated) if list was empty but option exists
        if [ -z "$proxies_json" ]; then
             local proxies_opt
             config_get proxies_opt "$config" proxies
             if [ -n "$proxies_opt" ]; then
                 append_proxy "$proxies_opt"
             fi
        fi

        # Default fallback
        if [ -z "$proxies_json" ]; then
            proxies_json="\"⭐Default Node Group⭐\", \"DIRECT\""
        fi
        
        if [ "$enable" == "1" ] && [ -n "$name" ] && [ -n "$ip" ]; then
             # Add proxy-group via yq expression
             CLIENT_EXPR="${CLIENT_EXPR}.[\"proxy-groups\"] += [{\"name\": \"${name}\", \"type\": \"select\", \"proxies\": [${proxies_json}]} ] |"
             # Collect rule lines for positional insertion (done after yq, see inject_client_rules)
             CLIENT_RULES_LINES="${CLIENT_RULES_LINES}  - SRC-IP-CIDR,${ip}/32,${name}\n"
        fi
    }
    # Load config and iterate
    config_load openproxy
    config_foreach handle_client_conf client

    # Closing expression, no vertical bar at the end
    ui_expr=".external-controller=strenv(ext_ctl)|.external-ui=strenv(DASHBOARD_UI)|.secret=strenv(tmp_secret)"
    yq_expr="${port_expr}${ipv6_expr}${tmode_expr}${proxy_expr}${rule_expr}${CLIENT_EXPR}${ui_expr}"
    config_path="$(uci -q get openproxy.config.config_path)"
    tmp_secret=${YACD_SECRET} DASHBOARD_UI=${DASHBOARD_UI} ext_ctl="${LANIP}:${YACD_PORT}" dns_listen=":${dns_port}" enmode="fake-ip" yq e -P "${yq_expr}" ${config_path} > ${CONFIG_FILE}

    # Inject client SRC-IP-CIDR rules at the placeholder or before MATCH
    inject_client_rules
}

# Insert collected CLIENT_RULES_LINES into CONFIG_FILE.
# Insertion point: the '# @CLIENT_RULES' placeholder line inside rules:, or
# as a fallback, immediately before the first '- MATCH,...' line.
inject_client_rules() {
    [ -z "$CLIENT_RULES_LINES" ] && return  # Nothing to inject

    local tmpfile="${CONFIG_FILE}.tmp"
    # Use printf to expand \n sequences in the collected lines
    local rules_block
    rules_block=$(printf '%b' "$CLIENT_RULES_LINES")

    if grep -q '# @CLIENT_RULES' "$CONFIG_FILE"; then
        # Replace the placeholder line with the client rule lines
        awk -v block="$rules_block" '
            /^[[:space:]]*#[[:space:]]*@CLIENT_RULES[[:space:]]*$/ {
                print block
                next
            }
            { print }
        ' "$CONFIG_FILE" > "$tmpfile"
        LOGGER "Client rules injected at @CLIENT_RULES placeholder"
    else
        # Fallback: insert before the first MATCH rule
        awk -v block="$rules_block" '
            !inserted && /^[[:space:]]*-[[:space:]]*MATCH,/ {
                print block
                inserted=1
            }
            { print }
        ' "$CONFIG_FILE" > "$tmpfile"
        LOGGER "Client rules injected before MATCH (no @CLIENT_RULES placeholder found)"
    fi

    mv "$tmpfile" "$CONFIG_FILE"
}
start_service() {
    enable=$(uci -q get openproxy.config.enable)
    if [ "$enable" == "0" ]; then
        return
    fi
    LOGGER "Starting openproxy service"
    LOGGER "1.Configure nftable rules"
    configure_nftables

    LOGGER "2.Yaml file formatting configuration"
    ! check_config_file && return 1
    LOGGER "Yaml file check completed."
    
    # Create log rotation wrapper
    MIHOMO_LOG="/tmp/mihomo.log"
    # Rotate log if it's larger than 1MB
    if [ -f "$MIHOMO_LOG" ]; then
        log_size=$(stat -c%s "$MIHOMO_LOG" 2>/dev/null || stat -f%z "$MIHOMO_LOG" 2>/dev/null || echo 0)
        if [ "$log_size" -gt 1048576 ]; then
            tail -n 1000 "$MIHOMO_LOG" > "$MIHOMO_LOG.tmp"
            mv "$MIHOMO_LOG.tmp" "$MIHOMO_LOG"
        fi
    fi
    
    procd_open_instance
    procd_set_param command /bin/sh -c "${PROC_BIN} -d ${WORK_PATH} >> /tmp/mihomo.log 2>&1"
    procd_set_param respawn
    procd_close_instance
    LOGGER "3.Process ${PROC_BIN} started successfully!"
}

stop_service() {
    LOGGER "Stopping openproxy service"
    LOGGER "1.Clean up nftable rules"
    cleanup_nftables
    killall ${PROC_BIN} >/dev/null 2>&1
    LOGGER "5.${PROC_BIN} Process has stopped!"
}
