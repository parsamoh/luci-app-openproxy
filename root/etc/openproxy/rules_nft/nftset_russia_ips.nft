#!/usr/sbin/nft -f

table inet oproxy_tproxy {
    set ruipv4 {
        type ipv4_addr ;
        flags interval ;
        # Placeholder for Russian IPv4 address ranges
        # Users should populate this with appropriate IP ranges for Russia
        # Example format: elements = { 5.3.0.0/16, 5.8.0.0/16, ... }
        elements = { }
    }
    set ruipv6 {
        type ipv6_addr ;
        flags interval ;
        # Placeholder for Russian IPv6 address ranges
        # Users should populate this with appropriate IPv6 ranges for Russia
        # Example format: elements = { 2001:67c::/32, ... }
        elements = { }
    }
    set local_ipv4 {
        type ipv4_addr ;
        flags interval ;
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0-255.255.255.255 }
    }

    set local_ipv6 {
        type ipv6_addr ;
        flags interval ;
        elements = { ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8, ::ffff:0:0/96, ::ffff:0:0:0/96, 64:ff9b::/96, 100::/64, 2001::/32, 2001:20::/28, 2001:db8::/32, 2002::/16 }
    }

    set all_ipv6 {
        type ipv6_addr ;
        flags interval ;
        elements = { ::/0 }
    }

}
